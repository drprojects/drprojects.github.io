  ((* endfor *))
}

\entry{Abroad}{\nohyphens\chips{((* for i in d.skills.international *))((( i.place | tex ))), ((( i.country | tex ))) \emeta{(((( i.period | tex ))))}((* if not loop.last *))\chipsep{}((* endif *))((* endfor *))}}
