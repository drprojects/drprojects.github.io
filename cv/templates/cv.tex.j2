((# ------------------------------------------------------------------------
    Academic CV template.

    Rendered by cv/build.py from _data/*.yml. Jinja delimiters are remapped so
    they do not collide with LaTeX braces:
        block: parenthesis-star   expression: triple-parenthesis
    Layout and typography live in cv/drcv.sty; this file is content structure.
------------------------------------------------------------------------- #))
\documentclass[10pt,a4paper]{article}
\usepackage{drcv}

((* set p = d.profile *))
((* set opts = p.get('cv_options', {}) *))

\begin{document}

((# ---------------------------------------------------------------- header #))
((* set L = p.links *))
\cvheader
  {((( p.name | tex )))}
  {((( p.tagline | tex )))}
  {((( p.summary | md2tex )))}
  {%
    \faEnvelope[regular]\, \href{mailto:((( L.email )))}{((( L.email | tex )))}\cvsep
    \faGlobe\, \href{((( L.website )))}{drprojects.github.io}\cvsep
    \faGithub\, \href{((( L.github )))}{((( L.github_user | tex )))}\cvsep
    \faOrcid\, \href{((( L.orcid )))}{((( L.orcid_id )))}\cvsep
    \faGraduationCap\, \href{((( L.scholar )))}{Scholar}\cvsep
    \faLinkedin\, \href{((( L.linkedin )))}{((( L.linkedin_user | tex )))}%
    ((* if p.get('metrics') and p.get('metrics').show and p.get('metrics').citations *))
    \cvsep ((( p.get('metrics').citations ))) citations, h-index ((( p.get('metrics').h_index )))%
    ((* endif *))
  }
  {images/portrait.png}

((# ------------------------------------------------------------- positions #))
\cvsection{Positions}
((* for x in for_cv(d.positions) *))
\entry{((( x.get('start') )))((* if x.get('end') != x.get('start') *))--((( x.get('end') if x.get('end') else 'now' )))((* endif *))}{%
  \etitle{((( x.title | tex )))} \\
  \eorg{((* if x.get('group') *))((( x.group | tex ))), ((* endif *))((( x.organizations | map('org_label') | join(' / ') | tex )))}((* if x.get('location') *)) \emeta{\;·\; ((( x.get('location') | tex )))}((* endif *))
  ((* if x.get('description') *))\\ \edesc{((( x.get('description') | md2tex )))}((* endif *))
  ((* if x.get('people') *))\\ ((* for role, group in x.get('people') | groupby('role') *))\emeta{((( role | tex )))((* if group | length > 1 *))s((* endif *)):} ((( group | map(attribute='person') | map('person_name') | join(', ') | tex )))((* if not loop.last *)) \emeta{\;·\;} ((* endif *))((* endfor *))((* endif *))
}
((* endfor *))

((# ------------------------------------------------------------- education #))
\cvsection{Education}
((* for x in for_cv(d.education) *))
\entry{((* if x.get('start') *))((( x.get('start') )))--((( x.get('end') )))((* else *))((( x.get('year') )))((* endif *))}{%
  \etitle{((( x.degree | tex )))} \\
  \eorg{((( x.organization | org_label(false) | tex )))}((* if x.get('location') *)) \emeta{\;·\; ((( x.get('location') | tex )))}((* endif *))
  ((* if x.get('description') *))\\ \edesc{((( x.get('description') | md2tex )))}((* endif *))
}
((* endfor *))

((# ---------------------------------------------------------------- awards #))
\cvsection{Awards}
((* for x in for_cv(d.awards) *))
\entry{((( x.get('year') )))}{%
  \etitle{((( x.title | tex )))}((* if x.get('venue') *)) \eorg{\;·\; ((( x.get('venue') | tex )))}((* endif *))
  ((* if x.get('description') *))\\ \emeta{((( x.get('description') | tex )))}((* endif *))
}
((* endfor *))

((# ---------------------------------------------------------- publications #))
((* set pubs = for_cv(d.publications) *))

\cvsection[\sparkbars{((( pub_hist_max )))}{((* for y, n in pub_hist *))((( y )))/((( n )))((* if not loop.last *)), ((* endif *))((* endfor *))}\sparkspan{((( pub_hist[0][0] )))}{((( pub_hist[-1][0] )))}]{Publications}
((# Under-review papers stay in the year list; the venue slot says so. #))
((* set ns = namespace(year=0) *))
((* for x in pubs *))
((* set showyear = x.get('year') != ns.year *))((* set ns.year = x.get('year') *))
\entry{((* if showyear *))((( x.get('year') )))((* endif *))}{%
  \etitle{((( x.title | tex )))} \\
  \eauth{((* for name, is_me in author_names(x.authors) *))((* if is_me *))\textbf{((( name )))}((* else *))((( name )))((* endif *))((* if not loop.last *)), ((* endif *))((* endfor *))} \\
  ((* if x.get('status') == 'under_review' *))\eorgalt{Under review}%
  ((* elif x.get('status') == 'thesis' *))\eorg{PhD Thesis((* if x.get('venue') *)), ((( x.get('venue') | tex )))((* endif *))}%
  ((* else *))\eorg{((( x.get('venue_long') | default(x.get('venue'), true) | tex )))}((* endif *))%
  ((* for h in x.get('highlights', []) *))\,\hltag{((( h.get('kind', 'selection') )))}{((( h.label | tex )))}((* endfor *))%
  ((* if x.get('selectivity') *)) \emeta{\;·\; ((( x.get('selectivity') | tex )))}((* endif *))
  ((* if x.get('jury') *))\\ \emeta{Jury: ((( x.get('jury') | join(', ') | tex )))}((* endif *))
  ((* if opts.get('show_publication_links') *))
  ((* set links = [] *))
  ((* if x.get('paper_url') *))((* set links = links + [(x.get('paper_url'), 'Paper')] *))((* endif *))
  ((* if x.get('project_url') *))((* set links = links + [(x.get('project_url'), 'Project')] *))((* endif *))
  ((* if x.get('code_url') *))((* set links = links + [(x.get('code_url'), 'Code')] *))((* endif *))
  ((* if links *)) \emeta{\;·\;} ((* for u, label in links *))\elink{((( u )))}{((( label )))}((* if not loop.last *))\elinksep((* endif *))((* endfor *))((* endif *))
  ((* endif *))
}
((* endfor *))

((# ----------------------------------------------------------- supervision #))
\cvsection{Collaboration \& Supervision}
((* for g in d.supervision.groups *))
\entry{((( g.label | tex )))}{%
  ((* for m in g.members *))%
    ((* if m.get('person') *))\etitle{((( m.person | person_name | tex )))}%
      ((* set who = d.authors[m.person] *))%
      ((* if who.get('org') *))\,\emeta{((( who.org | org_label | tex )))}((* endif *))%
    ((* else *))\etitle{((( m.organization | org_label(false) | tex )))}%
      ((* set who = d.organizations[m.organization] *))%
      ((* if who.get('location') *))\,\emeta{((( who.location | tex )))}((* endif *))%
    ((* endif *))%
    ((* if m.get('with') *))\,\emeta{with ((( m.with | map('entity_label') | join(' and ') | tex )))}((* endif *))%
    ((* if not loop.last *)) \emeta{\;·\;} ((* endif *))%
  ((* endfor *))
}
((* endfor *))

((# -------------------------------------------------------------- service #))
((# Reviewing, chairing and organising share one list, as on the website.
    Grouped one line per year to keep the section compact; the icon carries the
    role so the words "reviewer" / "area chair" need not be repeated. #))
\cvsection[\rolelegend{\icoreviewer\,Reviewer \quad \icochair\,Area chair \quad \icoorganiser\,Organising committee}]{Reviewing, Chairing \& Organising}
((* set svc_years = d.service | map(attribute='year') | list *))
((* set org_years = d.organizing | map(attribute='year') | list *))
((* set years = (svc_years + org_years) | unique | sort(reverse=true) | list *))
((* for y in years *))
\entry{((( y )))}{%
  ((* set ns3 = namespace(first=true) *))
  ((* for o in d.organizing if o.year == y *))((* if not ns3.first *))\emeta{\;·\;} ((* endif *))\icoorganiser\,((( o.event | tex )))((* set ns3.first = false *))((* endfor *))
  ((* for sv in d.service if sv.year == y *))((* if not ns3.first *))\emeta{\;·\;} ((* endif *))((* if sv.get('role') == 'area_chair' *))\icochair((* else *))\icoreviewer((* endif *))\,((( sv.venue | tex )))((* set ns3.first = false *))((* endfor *))
}
((* endfor *))

\cvsection{Teaching}
((* for x in for_cv(d.teaching) *))
\entry{((( x.get('year') )))}{%
  \etitle{((( x.title | tex )))}
  \emeta{\;·\;} \eorg{((( x.institution_short | default(x.institution, true) | tex )))}
  \emeta{\;·\; ((( x.format | tex )))((* if x.get('level') *)), ((( x.get('level') | tex )))((* endif *))}%
  ((* if opts.get('show_teaching_hours') *))((* if x.get('hours') *))\etrail{((( x.get('hours') ))) h}((* elif x.get('duration') *))\etrail{((( x.get('duration') | tex )))}((* endif *))((* endif *))
}
((* endfor *))

((# ----------------------------------------------------------------- code #))
\cvsection{Open-Source Software}
((* for x in for_cv(d.code) *))
((* set s = stars.get(x.repo, {}) *))
\entry{((* if s.get('stars') is not none *))\repostats{((( s.get('stars') )))}{((( s.get('forks', 0) )))}((* endif *))}{%
  \etitle{((( x.title | tex )))}
  \emeta{\;·\; \faGithub\,((( x.repo | tex )))}%
}
((* endfor *))

((# ---------------------------------------------------------------- talks #))
((* set talks = for_cv(d.talks, false) *))
\cvsection{Selected Talks}
((* set ns2 = namespace(year=0) *))
((* for x in talks *))
((* set yr = x.date.year *))
((* set showyear = yr != ns2.year *))((* set ns2.year = yr *))
\entry{((* if showyear *))((( yr )))((* endif *))}{%
  \etitle{((( x.get('venue') | tex )))}
  ((* if x.get('type') != 'invited' *))\emeta{\;·\; ((( x.get('type') | tex )))}((* endif *))
  \emeta{\;·\;} \edesc{((( x.title | tex )))}%
  ((* if x.get('location') *)) \emeta{\;·\; ((( x.get('location') | tex )))}((* endif *))
}
((* endfor *))
\entry{}{\emeta{((( d.talks | length ))) talks given since 2021 --- full list at \href{((( p.links.website )))/talks/}{drprojects.github.io/talks}.}}

